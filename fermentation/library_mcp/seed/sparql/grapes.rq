#defaultView:Table
# Every grape variety (Q10978) with optional color, origin country, and
# aggregated synonyms (skos:altLabel). Color (wdt:P462) maps to a colour
# label; consumers should bucket into {red, white, rose, gris} downstream.
SELECT ?grape ?grapeLabel ?colorLabel ?origin ?originLabel
       (GROUP_CONCAT(DISTINCT ?alt; SEPARATOR="||") AS ?synonyms)
WHERE {
  ?grape (wdt:P31/wdt:P279*) wd:Q958314 .
  OPTIONAL { ?grape wdt:P462 ?color . }
  OPTIONAL { ?grape wdt:P495 ?origin . }
  OPTIONAL { ?grape skos:altLabel ?alt . FILTER (LANG(?alt) = "en") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
GROUP BY ?grape ?grapeLabel ?colorLabel ?origin ?originLabel
